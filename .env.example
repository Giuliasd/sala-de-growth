# Banco de dados (Postgres)
DATABASE_URL="postgresql://user:pass@localhost:5432/sala_de_growth"

# NextAuth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (auth principal)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail promovido para LIDERANCA no login (e usado como default no botão de
# dev bypass). Sem a variável, ninguém é auto-promovido — não há fallback no
# código. Só cria conta nova se o time não tiver ninguém ativo na liderança ou
# se houver convite válido: quem foi desativado volta só com convite.
# ADMIN_EMAIL="admin@seu.dominio"

# ----------------------------------------------------------------------------
# Dev-only: bypass de login (opt-in, NUNCA ativa em produção)
# Quando "true", a tela de login mostra o botão "Entrar como admin (dev)".
# Requer também NODE_ENV !== "production".
# ----------------------------------------------------------------------------
# DEV_BYPASS_AUTH=true

# ----------------------------------------------------------------------------
# MCP (Claude conectado à Sala) — ver "MCP" no AGENTS.md
# MCP_ENABLED é o kill switch: sem "true" a rota /api/mcp responde 503.
# MCP_GOOGLE_CLIENT_ID é o ID de um cliente OAuth do Google SÓ para o MCP
# (separado do login: o segredo dele é entregue ao Claude). O servidor valida
# que o token foi emitido para este client (aud) e NÃO guarda o segredo.
# ----------------------------------------------------------------------------
# MCP_ENABLED=true
# MCP_GOOGLE_CLIENT_ID=""
